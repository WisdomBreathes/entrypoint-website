---
const base = import.meta.env.BASE_URL;
// ServicesGrid — homepage service index, 5 service entries + 1 CTA

const services = [
  {
    title: 'Permanent residence',
    description: 'Express Entry, Federal Skilled Worker, Canadian Experience Class, and Provincial Nominee Program.',
    label: ['Permanent', 'residence'],
    href: `${base}services#permanent-residency`,
  },
  {
    title: 'Family sponsorship',
    description: 'Spousal sponsorship, open work permits, parents & grandparents, and dependent children.',
    label: ['Sponsor', 'family'],
    href: `${base}services#family-sponsorship`,
  },
  {
    title: 'Study and work permits',
    description: 'Study permits, post-graduation work permits (PGWP), LMIA, and employer-specific work permits.',
    label: ['Study or', 'work'],
    href: `${base}services#work-study`,
  },
  {
    title: 'Canadian citizenship',
    description: 'Canadian citizenship applications, test preparation, and ceremony guidance.',
    label: ['Citizenship'],
    href: `${base}services#citizenship`,
  },
  {
    title: 'Refugee and humanitarian matters',
    description: 'Refugee protection claims, protected person applications, and humanitarian and compassionate grounds.',
    label: ['Refugee', 'and H&C'],
    href: `${base}services#refugee`,
  },
] as const;
---

<section style="background: #FAF7F2;" aria-labelledby="services-heading">

  <div class="section-container">

    <!-- Section label + heading -->
    <p style="font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: #8B1A1A; margin-bottom: 8px;">
      What we do
    </p>
    <h2 id="services-heading" style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(24px, 2.5vw, 32px); font-weight: 600; color: #1A1A2E; line-height: 1.25; margin-bottom: 8px; max-width: 460px;">
      Major immigration matters, handled with regulated guidance.
    </h2>
    <p style="font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 300; color: #45465E; margin-bottom: 32px; max-width: 480px; line-height: 1.7;">
      Whether you are applying for the first time or dealing with a more complex file, we help you understand the process, the requirements, and the available options for your situation.
    </p>

    <!-- Service index -->
    <div class="home-services-index">
      {services.map((service, index) => (
        <a
          href={service.href}
          class="home-service-entry"
        >
          <div class="home-service-meta">
            <span class="home-service-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="home-service-label">
              {service.label.map((line) => <span>{line}</span>)}
            </span>
          </div>

          <div class="home-service-copy">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>

          <span class="home-service-link">View service</span>
        </a>
      ))}

      <a
        href={`${base}contact`}
        class="home-service-entry home-service-entry-cta"
      >
        <div class="home-service-meta">
          <span class="home-service-number" aria-hidden="true">06</span>
          <span class="home-service-label">
            <span>First</span>
            <span>conversation</span>
          </span>
        </div>

        <div class="home-service-copy">
          <h3>Not sure which service fits?</h3>
          <p>
            Start with a consultation to review your options before deciding how to proceed.
          </p>
        </div>

        <span class="home-service-link">Schedule a consultation</span>
      </a>

    </div>
  </div>
</section>

<style>
  .home-services-index {
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid #E8E3D9;
    border-radius: 10px;
    overflow: hidden;
    background: rgba(255,255,255,0.36);
  }

  .home-service-entry {
    display: grid;
    grid-template-columns: minmax(86px, 0.32fr) minmax(0, 1fr);
    grid-template-rows: auto auto auto;
    column-gap: 18px;
    row-gap: 0;
    align-items: start;
    min-height: 228px;
    padding: 24px;
    background: rgba(255,255,255,0.44);
    border-right: 1px solid #E8E3D9;
    border-bottom: 1px solid #E8E3D9;
    color: inherit;
    text-decoration: none;
    transition: background 0.18s ease, transform 0.18s ease;
  }

  .home-service-entry:hover {
    background: #ffffff;
    transform: translateY(-2px);
  }

  .home-service-entry:focus-visible {
    outline: 2px solid #1C2456;
    outline-offset: -2px;
  }

  .home-service-meta {
    display: flex;
    grid-row: 1 / -1;
    min-width: 0;
    flex-direction: column;
    gap: 8px;
  }

  .home-service-number,
  .home-service-label {
    display: block;
  }

  .home-service-number {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 28px;
    font-weight: 600;
    line-height: 1;
    color: rgba(61,18,21,0.32);
    letter-spacing: 0;
  }

  .home-service-label {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8B1A1A;
  }

  .home-service-label span {
    display: block;
    white-space: nowrap;
  }

  .home-service-copy {
    grid-column: 2;
    display: contents;
    min-width: 0;
  }

  .home-service-copy h3 {
    grid-column: 2;
    grid-row: 1;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    color: #1A1A2E;
    min-height: 44px;
    margin: 0;
  }

  .home-service-copy p {
    grid-column: 2;
    grid-row: 2;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 300;
    line-height: 1.7;
    color: #45465E;
    min-height: 82px;
    margin: 2px 0 0;
  }

  .home-service-link {
    grid-column: 2;
    grid-row: 3;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
    color: #8B1A1A;
    margin-top: 14px;
  }

  .home-service-link::after {
    content: '';
    display: inline-block;
    width: 0.42em;
    height: 0.42em;
    margin-left: 0.48em;
    border-top: 1.5px solid currentColor;
    border-right: 1.5px solid currentColor;
    transform: translateY(-0.06em) rotate(45deg);
  }

  .home-service-entry-cta {
    background: #3D1215;
  }

  .home-service-entry-cta:hover {
    background: #2C0D0F;
  }

  .home-service-entry-cta .home-service-number {
    color: rgba(196,151,58,0.62);
  }

  .home-service-entry-cta .home-service-label,
  .home-service-entry-cta .home-service-link {
    color: #C4973A;
  }

  .home-service-entry-cta .home-service-copy h3 {
    color: #ffffff;
  }

  .home-service-entry-cta .home-service-copy p {
    color: rgba(255,255,255,0.74);
  }

  @media (min-width: 640px) {
    .home-services-index {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 1fr;
    }

    .home-service-entry:nth-child(2n) {
      border-right: 0;
    }
  }

  @media (min-width: 1024px) {
    .home-services-index {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .home-service-entry:nth-child(2n) {
      border-right: 1px solid #E8E3D9;
    }

    .home-service-entry:nth-child(3n) {
      border-right: 0;
    }

    .home-service-entry:nth-last-child(-n + 3) {
      border-bottom: 0;
    }
  }

  @media (max-width: 768px) {
    .home-service-entry {
      grid-template-columns: 64px minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      min-height: 0;
      padding: 20px;
    }

    .home-service-copy h3 {
      font-size: 16px !important;
      line-height: 1.3 !important;
      min-height: 0;
      margin-bottom: 10px;
    }

    .home-service-copy p {
      font-size: 14px !important;
      line-height: 1.75 !important;
      min-height: 0;
    }

    .home-service-link {
      font-size: 13px !important;
    }
  }

  @media (max-width: 639px) {
    .home-service-entry {
      border-right: 0;
    }

    .home-service-entry:last-child {
      border-bottom: 0;
    }
  }
</style>
