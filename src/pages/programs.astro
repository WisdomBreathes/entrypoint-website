---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;

const programsPageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://entrypointcanada.com/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Canadian Immigration Programs',
        item: 'https://entrypointcanada.com/programs/',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Canadian Immigration Programs and Special Streams',
    description: 'Overview of Canadian immigration pathways including Express Entry, Provincial Nominee Program, Ontario Immigrant Nominee Program updates, Canadian Experience Class, post-graduation work permits, LMIA-supported work permits, family sponsorship, and specialist streams.',
    url: 'https://entrypointcanada.com/programs/',
    dateModified: '2026-06-30',
    inLanguage: 'en-CA',
    isPartOf: {
      '@type': 'WebSite',
      name: 'Entrypoint Canada',
      url: 'https://entrypointcanada.com/',
    },
    about: [
      'Express Entry',
      'Provincial Nominee Program',
      'Ontario Immigrant Nominee Program',
      'Canadian Experience Class',
      'Post-Graduation Work Permit',
      'Labour Market Impact Assessment',
      'Family Sponsorship',
      'Francophone Mobility',
      'Entrepreneur Work Permit',
    ],
    mainEntity: {
      '@type': 'ItemList',
      name: 'Immigration pathways covered',
      itemListElement: [
        'Express Entry',
        'Provincial Nominee Program (PNP)',
        'Canadian Experience Class and in-Canada applicants',
        'Ontario Workforce Priority Stream',
        'Study Permit and Post-Graduation Work Permit',
        'Employer Work Permits and LMIA Support',
        'Spousal, Partner, and Child Sponsorship',
        'C11 Entrepreneur Work Permit',
        'C16 Francophone Mobility',
        'C44 Postdoctoral Research',
      ].map((name, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name,
      })),
    },
  },
];
---

<Layout
  title="Canadian Immigration Programs: Express Entry, OINP, PGWP & LMIA | Entrypoint Canada"
  description="Explore Express Entry, PNP, OINP updates, CEC, PGWP, LMIA work permits, family sponsorship, and specialist streams with an RCIC in Cambridge, Ontario."
  heroImage="programs"
  schema={programsPageSchema}
>
  <Navbar />
  <main id="main-content">

    <!-- Page hero -->
    <section style="position: relative; overflow: hidden; background: #1A0A0A; padding: 56px 0 52px; min-height: 360px; display: flex; align-items: center;">
      <picture>
        <source
          type="image/webp"
          srcset={`${base}images/cole-keister-rydTSO7xB5A-unsplash-800w.webp 800w, ${base}images/cole-keister-rydTSO7xB5A-unsplash-1400w.webp 1400w`}
          sizes="100vw"
        />
        <img
          src={`${base}images/cole-keister-rydTSO7xB5A-unsplash-1400w.webp`}
          alt=""
          aria-hidden="true"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          width="1400"
          height="2099"
          style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center;"
        />
      </picture>
      <div style="position: absolute; inset: 0; background: rgba(10,5,5,0.65);"></div>
      <div class="page-hero-inner page-hero-copy" style="position: relative; z-index: 1;">
        <a href={base} class="page-back-link" style="display: inline-flex; align-items: center; gap: 6px; font-family: Inter, sans-serif; font-size: 13px; color: rgba(255,255,255,0.6); text-decoration: none; margin-bottom: 24px; transition: color 0.15s;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          Back to home
        </a>
        <p style="font-family: Inter, sans-serif; font-size: 10px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: #C4973A; margin-bottom: 12px;">
          Immigration Programs
        </p>
        <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(30px, 4vw, 42px); font-weight: 700; color: #ffffff; line-height: 1.15; margin-bottom: 16px; max-width: 720px;">
          Canadian Immigration Programs &amp; Special Streams
        </h1>
        <p style="font-family: Inter, sans-serif; font-size: 17px; font-weight: 300; color: rgba(255,255,255,0.75); line-height: 1.7; max-width: 600px;">
          Review major permanent residence, work permit, and pilot program categories that may apply depending on profile, timing, and current eligibility requirements.
        </p>
      </div>
    </section>

    <!-- Section 0: Core Pathways — Express Entry & PNP -->
    <section style="background: #ffffff; padding: 56px 0;">
      <div class="section-container">

        <div style="margin-bottom: 32px;">
          <p class="program-section-kicker" style="color: #1C2456;">Core Pathways</p>
          <h2 style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(24px, 2.5vw, 32px); font-weight: 600; color: #1A1A2E; line-height: 1.2; margin-bottom: 12px;">
            Express Entry &amp; Provincial Nominee Programs
          </h2>
          <p style="font-family: Inter, sans-serif; font-size: 16px; font-weight: 300; color: #45465E; line-height: 1.7; max-width: 640px;">
            These are the two main systems used for economic permanent residence and are often the first programs reviewed when assessing long-term eligibility.
          </p>
        </div>

        <div class="grid-programs-2col">

          <!-- Express Entry -->
          <article class="program-card" style="background: #ffffff; border-radius: 10px; border: 1px solid #E8E3D9; overflow: hidden; display: flex; flex-direction: column;">
            <div style="padding: 24px 24px 16px;">
              <div class="program-meta-row">
                <span>Federal program</span>
                <span>Permanent residence</span>
              </div>
              <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 22px; font-weight: 700; color: #1A1A2E; line-height: 1.25; margin-bottom: 12px;">
                Express Entry
              </h3>
              <p style="font-family: Inter, sans-serif; font-size: 14px; font-weight: 300; color: #45465E; line-height: 1.75; margin-bottom: 16px;">
                Express Entry is Canada's online application system for several federal economic permanent residence programs. It covers the Federal Skilled Worker Program, the Federal Skilled Trades Program, and the Canadian Experience Class, as well as a portion of the Provincial Nominee Program.
              </p>
              <p style="font-family: Inter, sans-serif; font-size: 14px; font-weight: 300; color: #45465E; line-height: 1.75; margin-bottom: 16px;">
                Candidates create a profile and enter a pool ranked by the Comprehensive Ranking System (CRS). IRCC regularly issues Invitations to Apply (ITAs) through draws, which target either all eligible candidates or specific occupational categories.
              </p>
              <p style="font-family: Inter, sans-serif; font-size: 14px; font-weight: 300; color: #45465E; line-height: 1.75; margin-bottom: 24px;">
                As of March 31, 2026, IRCC lists category-based selection streams for French-language proficiency, healthcare and social services, STEM, trades, education, transport, physicians with Canadian work experience, senior managers with Canadian work experience, researchers with Canadian work experience, and skilled military recruits. Draws are held regularly throughout the year, but categories and priorities can change.
              </p>
              <ul style="list-style: none; padding: 0; margin: 0 0 16px; display: flex; flex-direction: column; gap: 10px;">
                {[
                  'Skilled work experience in an eligible NOC occupation',
                  'Language proficiency in English or French (CLB/NCLC varies by program)',
                  'Educational credentials meeting program minimums',
                  'Meeting the specific requirements of at least one Express Entry program',
                ].map((item) => (
                  <li style="display: flex; align-items: flex-start; gap: 10px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1C2456" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"/></svg>
                    <span style="font-family: Inter, sans-serif; font-size: 13px; font-weight: 300; color: #3D3D5C; line-height: 1.6;">{item}</span>
                  </li>
                ))}
              </ul>
              <p style="font-family: Inter, sans-serif; font-size: 12px; font-weight: 300; color: #9C9C9C; line-height: 1.65; margin-bottom: 24px;">
                Express Entry categories and CRS cut-off scores change with each draw. Eligibility should be assessed against current IRCC requirements.
              </p>
            </div>
            <div style="padding: 0 24px 24px; margin-top: auto;">
              <a href={`${base}contact`} class="btn-gold" style="display: inline-flex; align-items: center; gap: 8px; font-family: Inter, sans-serif; font-size: 14px; font-weight: 500; color: #1A1A2E; background: #C4973A; padding: 12px 22px; border-radius: 6px; text-decoration: none;">
                Review this program
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            </div>
          </article>

          <!-- Provincial Nominee Program -->
          <article class="program-card" style="background: #ffffff; border-radius: 10px; border: 1px solid #E8E3D9; overflow: hidden; display: flex; flex-direction: column;">
            <div style="padding: 24px 24px 16px;">
              <div class="program-meta-row">
                <span>Federal-provincial program</span>
                <span>Nomination route</span>
              </div>
              <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 22px; font-weight: 700; color: #1A1A2E; line-height: 1.25; margin-bottom: 12px;">
                Provincial Nominee Program (PNP)
              </h3>
              <p style="font-family: Inter, sans-serif; font-size: 14px; font-weight: 300; color: #45465E; line-height: 1.75; margin-bottom: 16px;">
                The Provincial Nominee Program allows Canadian provinces and territories to nominate candidates for permanent residence based on local labour market and economic needs. Each province operates its own streams with distinct eligibility criteria, occupation lists, and intake schedules.
              </p>
              <p style="font-family: Inter, sans-serif; font-size: 14px; font-weight: 300; color: #45465E; line-height: 1.75; margin-bottom: 16px;">
                Many PNP streams are aligned with Express Entry. A provincial nomination can add 600 CRS points, which can make a candidate highly competitive in the Express Entry pool. Other streams operate outside Express Entry through a separate non-Express Entry process.
              </p>
              <p style="font-family: Inter, sans-serif; font-size: 14px; font-weight: 300; color: #45465E; line-height: 1.75; margin-bottom: 24px;">
                Active PNP programs exist across British Columbia, Ontario, Alberta, Saskatchewan, Manitoba, Nova Scotia, New Brunswick, Prince Edward Island, Newfoundland and Labrador, Northwest Territories, and Yukon, but each program can change its intake, categories, and application steps.
              </p>
              <ul style="list-style: none; padding: 0; margin: 0 0 16px; display: flex; flex-direction: column; gap: 10px;">
                {[
                  'Job offer from a provincial employer, or',
                  'Expression of Interest submitted to a provincial pool, or',
                  'Nomination through an Express Entry-aligned stream',
                  'Meeting the specific occupation, language, and settlement fund requirements of the target province',
                ].map((item) => (
                  <li style="display: flex; align-items: flex-start; gap: 10px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1C2456" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"/></svg>
                    <span style="font-family: Inter, sans-serif; font-size: 13px; font-weight: 300; color: #3D3D5C; line-height: 1.6;">{item}</span>
                  </li>
                ))}
              </ul>
              <p style="font-family: Inter, sans-serif; font-size: 12px; font-weight: 300; color: #9C9C9C; line-height: 1.65; margin-bottom: 24px;">
                PNP streams open and close frequently. Intake windows, occupation lists, and eligibility thresholds vary by province and can change without notice.
              </p>
            </div>
            <div style="padding: 0 24px 24px; margin-top: auto;">
              <a href={`${base}contact`} class="btn-gold" style="display: inline-flex; align-items: center; gap: 8px; font-family: Inter, sans-serif; font-size: 14px; font-weight: 500; color: #1A1A2E; background: #C4973A; padding: 12px 22px; border-radius: 6px; text-decoration: none;">
                Review this program
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            </div>
          </article>

        </div>
      </div>
    </section>

    <!-- Section 1: Time-Sensitive Programs -->
    <section style="background: #FAF7F2; padding: 56px 0;">
      <div class="section-container">

        <div style="margin-bottom: 32px;">
          <p class="program-section-kicker" style="color: #92400E;">Time-Sensitive</p>
          <h2 style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(24px, 2.5vw, 32px); font-weight: 600; color: #1A1A2E; line-height: 1.2; margin-bottom: 12px;">
            Programs with Current or Recent Intake Windows
          </h2>
          <p style="font-family: Inter, sans-serif; font-size: 16px; font-weight: 300; color: #45465E; line-height: 1.7; max-width: 640px;">
            Some programs move quickly because they open in limited rounds, depend on community recommendation, or fill once intake caps are reached.
          </p>
          <p style="font-family: Inter, sans-serif; font-size: 12px; font-weight: 300; color: #9C9C9C; margin-top: 10px; line-height: 1.65; max-width: 640px;">
            Availability, eligibility, and intake periods may change without notice based on IRCC, provincial, or pilot program updates.
          </p>
        </div>

        <div class="grid-programs-2col">

          <!-- Canadian Experience Class and in-Canada applicants -->
          <article class="program-card" style="background: #ffffff; border-radius: 10px; border: 1px solid #E8E3D9; overflow: hidden; display: flex; flex-direction: column;">
            <div class="program-card-body program-card-body-balanced" style="padding: 24px 24px 16px;">
              <div class="program-meta-row">
                <span>Express Entry program</span>
                <span>In-Canada profiles</span>
              </div>
              <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 22px; font-weight: 700; color: #1A1A2E; line-height: 1.25; margin-bottom: 12px;">
                Canadian Experience Class and In-Canada Applicants
              </h3>
              <p style="font-family: Inter, sans-serif; font-size: 14px; font-weight: 300; color: #45465E; line-height: 1.75; margin-bottom: 24px;">
                The original Temporary Resident to Permanent Resident Pathway is closed and stopped accepting applications on November 5, 2021. Applicants in Canada may still have permanent residence options through active programs, including the Canadian Experience Class, provincial nominee streams, or another category that fits their work experience, status, language results, and admissibility.
              </p>
              <ul style="list-style: none; padding: 0; margin: 0 0 28px; display: flex; flex-direction: column; gap: 10px;">
                {[
                  'Skilled Canadian work experience that supports eligibility under Express Entry or another active pathway',
                  'Valid temporary status in Canada and a possible route to permanent residence through an active program',
                  'Language results, education, and admissibility requirements matching the selected pathway',
                  'A profile that may fit the Canadian Experience Class, a provincial nominee stream, or another active program',
                ].map((item) => (
                  <li style="display: flex; align-items: flex-start; gap: 10px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C4973A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"/></svg>
                    <span style="font-family: Inter, sans-serif; font-size: 13px; font-weight: 300; color: #3D3D5C; line-height: 1.6;">{item}</span>
                  </li>
                ))}
              </ul>
              <div class="program-card-note" style="background: #FFFBEB; border: 1px solid #F0D080; border-radius: 8px; padding: 14px 16px; margin-bottom: 24px;">
                <p style="font-family: Inter, sans-serif; font-size: 13px; font-weight: 400; color: #78350F; line-height: 1.6; margin: 0;">
                  <strong>Important update:</strong> The old TR to PR pathway closed on November 5, 2021. Some people with a pending 2021 application may qualify for an open work permit until December 31, 2026, but new permanent residence applications are not being accepted under that pathway.
                </p>
              </div>
            </div>
            <div style="padding: 0 24px 24px; margin-top: auto;">
              <a href={`${base}contact`} class="btn-gold" style="display: inline-flex; align-items: center; gap: 8px; font-family: Inter, sans-serif; font-size: 14px; font-weight: 500; color: #1A1A2E; background: #C4973A; padding: 12px 22px; border-radius: 6px; text-decoration: none;">
                Review this program
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            </div>
          </article>

          <!-- Ontario Workforce Priority and OINP redesign -->
          <article class="program-card" style="background: #ffffff; border-radius: 10px; border: 1px solid #E8E3D9; overflow: hidden; display: flex; flex-direction: column;">
            <div class="program-card-body program-card-body-balanced" style="padding: 24px 24px 16px;">
              <div class="program-meta-row">
                <span>Ontario update</span>
                <span>OINP redesign</span>
              </div>
              <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 22px; font-weight: 700; color: #1A1A2E; line-height: 1.25; margin-bottom: 12px;">
                Ontario Workforce Priority Stream
              </h3>
              <p style="font-family: Inter, sans-serif; font-size: 14px; font-weight: 300; color: #45465E; line-height: 1.75; margin-bottom: 24px;">
                Ontario updated the Ontario Immigrant Nominee Program on June 26, 2026 as part of an OINP redesign. The province says the former eight streams have been removed, the EOI system is closed to new EOIs, and no further invitations will be issued under the former program streams.
              </p>
              <ul style="list-style: none; padding: 0; margin: 0 0 28px; display: flex; flex-direction: column; gap: 10px;">
                {[
                  'Ontario workforce priority: TEER 0-3 category',
                  'Ontario workforce priority: TEER 4-5 category',
                  'Ontario workforce priority: self-employed physician category',
                  'Applications already received under the former framework are assessed against the requirements in place at the time of application',
                ].map((item) => (
                  <li style="display: flex; align-items: flex-start; gap: 10px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C4973A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"/></svg>
                    <span style="font-family: Inter, sans-serif; font-size: 13px; font-weight: 300; color: #3D3D5C; line-height: 1.6;">{item}</span>
                  </li>
                ))}
              </ul>
              <div class="program-card-note" style="background: #ECFDF5; border: 1px solid #6EE7B7; border-radius: 8px; padding: 14px 16px; margin-bottom: 24px;">
                <p style="font-family: Inter, sans-serif; font-size: 13px; font-weight: 400; color: #065F46; line-height: 1.6; margin: 0;">
                  <strong>Portal note:</strong> Ontario says the e-Filing Portal is expected to reopen later this summer. Until the new system reopens, OINP eligibility should be checked against the current Ontario page and amended regulations.
                </p>
              </div>
            </div>
            <div style="padding: 0 24px 24px; margin-top: auto;">
              <a href={`${base}contact`} class="btn-gold" style="display: inline-flex; align-items: center; gap: 8px; font-family: Inter, sans-serif; font-size: 14px; font-weight: 500; color: #1A1A2E; background: #C4973A; padding: 12px 22px; border-radius: 6px; text-decoration: none;">
                Review this program
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            </div>
          </article>

        </div>
      </div>
    </section>

    <!-- Section 2: Common Client Pathways -->
    <section style="background: #ffffff; padding: 56px 0;">
      <div class="section-container">

        <div style="margin-bottom: 32px;">
          <p class="program-section-kicker" style="color: #1C2456;">Common Searches</p>
          <h2 style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(24px, 2.5vw, 32px); font-weight: 600; color: #1A1A2E; line-height: 1.2; margin-bottom: 12px;">
            High-Demand Immigration Pathways
          </h2>
          <p style="font-family: Inter, sans-serif; font-size: 16px; font-weight: 300; color: #45465E; line-height: 1.7; max-width: 680px;">
            These categories match frequent client questions and are supported by current Canada.ca program pages, making them useful starting points for many students, workers, employers, and families.
          </p>
        </div>

        <div class="grid-programs-3col">

          <!-- Study Permit and PGWP -->
          <article class="program-card" style="background: #ffffff; border-radius: 10px; border: 1px solid #E8E3D9; padding: 24px; display: flex; flex-direction: column;">
            <div class="program-meta-row program-meta-row-compact">
              <span>Student route</span>
              <span>PGWP</span>
            </div>
            <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 19px; font-weight: 700; color: #1A1A2E; line-height: 1.3; margin-bottom: 12px;">
              Study Permit and Post-Graduation Work Permit
            </h3>
            <p style="font-family: Inter, sans-serif; font-size: 14px; font-weight: 300; color: #45465E; line-height: 1.75; margin-bottom: 20px; flex: 1;">
              International students may need a study permit before beginning a Canadian program, and some graduates may qualify for a post-graduation work permit after completing an eligible program at a designated learning institution.
            </p>
            <ul style="list-style: none; padding: 0; margin: 0 0 24px; display: flex; flex-direction: column; gap: 8px;">
              {[
                'Admission to an eligible Canadian school or designated learning institution',
                'Proof of funds, identity documents, and a complete study plan where needed',
                'PGWP eligibility based on the program, school, length of study, and current IRCC requirements',
              ].map((item) => (
                <li style="display: flex; align-items: flex-start; gap: 8px;">
                  <span style="width: 5px; height: 5px; border-radius: 50%; background: #C4973A; flex-shrink: 0; margin-top: 7px;"></span>
                  <span style="font-family: Inter, sans-serif; font-size: 13px; font-weight: 300; color: #3D3D5C; line-height: 1.6;">{item}</span>
                </li>
              ))}
            </ul>
            <a href={`${base}contact`} class="program-inline-link" style="font-family: Inter, sans-serif; font-size: 13px; font-weight: 500; color: #1C2456; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; border-bottom: 1px solid #1C2456; padding-bottom: 2px; width: fit-content; transition: opacity 0.15s;">
              Review this pathway
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </article>

          <!-- Employer Work Permits and LMIA -->
          <article class="program-card" style="background: #ffffff; border-radius: 10px; border: 1px solid #E8E3D9; padding: 24px; display: flex; flex-direction: column;">
            <div class="program-meta-row program-meta-row-compact">
              <span>Employer route</span>
              <span>LMIA / work permit</span>
            </div>
            <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 19px; font-weight: 700; color: #1A1A2E; line-height: 1.3; margin-bottom: 12px;">
              Employer Work Permits and LMIA Support
            </h3>
            <p style="font-family: Inter, sans-serif; font-size: 14px; font-weight: 300; color: #45465E; line-height: 1.75; margin-bottom: 20px; flex: 1;">
              Employers may need a Labour Market Impact Assessment before a foreign worker can apply for an employer-specific work permit. Some cases may use an LMIA-exempt category under the International Mobility Program instead.
            </p>
